---
layout: default
---
<div class="post">

  <!-- ================= HERO ================= -->
  <header class="hero text-center">

    {% if page.profile and page.profile.image %}
      {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        <img src="{{ profile_image_path | relative_url }}" class="hero-logo" alt="logo">
    {% endif %}

    <h1 class="hero-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }} {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>

    {% if page.subtitle %}
      <p class="hero-subtitle">{{ page.subtitle }}</p>
    {% endif %}

  </header>

  <!-- ================= CONTENT ================= -->
  <article>

    <!-- ABOUT -->
    <section class="section about">
      <div class="clearfix">{{ content }}</div>
    </section>

    <!-- PUBLICATIONS -->
    {% if page.selected_papers %}
      <section class="section publications">
        <h2>Latest Publications</h2>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

    <!-- NEWS -->
    {% if page.announcements and page.announcements.enabled %}
      <section class="section news">
        <h2>News</h2>
        {% include news.liquid limit=page.announcements.limit %}
      </section>
    {% endif %}

  </article>
</div>