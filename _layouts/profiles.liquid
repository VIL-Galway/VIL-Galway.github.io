---
layout: default
---

<div class="post">
  <article>

    <!-- PIs -->
    {% if page.pis %}
    <h2>Principal Investigators</h2>

    <div class="profiles-grid">
      {% assign first_pi = page.pis | first %}

      <div class="profile-card">
        {% if first_pi.image %}
          <img src="{{ '/assets/img/people/' | append: first_pi.image | relative_url }}"
              alt="{{ first_pi.name }}"
              class="profile-photo">
        {% endif %}

        <h3>
          {% if first_pi.link %}
            <a href="{{ first_pi.link | relative_url }}">{{ first_pi.name }}</a>
          {% else %}
            {{ first_pi.name }}
          {% endif %}
        </h3>

        {% if first_pi.role %}
          <p class="role">{{ first_pi.role }}</p>
        {% endif %}

        <div class="profile-links">
          {% if first_pi.email %}
            <a href="mailto:{{ first_pi.email }}" class="icon-link" title="Email">
              <i class="fa-solid fa-envelope"></i>
            </a>
          {% endif %}

          {% if first_pi.link %}
            <a href="{{ first_pi.link }}" target="_blank" class="icon-link" title="Profile">
              <i class="fa-solid fa-up-right-from-square"></i>
            </a>
          {% endif %}
        </div>
      </div>
    </div>
    {% endif %}

    <!-- PIs -->
    {% if page.pis %}
    <div class="profiles-grid">
      {% for person in page.pis offset:1 %}
        <div class="profile-card">
          {% if person.image %}
            <img src="{{ '/assets/img/people/' | append: person.image | relative_url }}" alt="{{ person.name }}" class="profile-photo">
