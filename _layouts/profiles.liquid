---
layout: default
---

<div class="post">
  <article>

    <!-- ===================== -->
    <!-- PIs -->
    <!-- ===================== -->
    {% if page.pis %}
    <h2>Faculty</h2>
    <div class="profiles-grid">
      {% for person in page.pis %}
        <div class="profiles-card">
          {% if person.image %}
            <img src="{{ '/assets/img/people/' | append: person.image | relative_url }}" class="profile-photo">
          {% endif %}

          <h3>
            {% if person.link %}
              <a href="{{ person.link }}">{{ person.name }}</a>
            {% else %}
              {{ person.name }}
            {% endif %}
          </h3>

          {% if person.role %}
            <p class="role">{{ person.role }}</p>
          {% endif %}

          <!-- ICONS -->
          <div class="profile-icons">
            {% if person.email %}
              <a href="mailto:{{ person.email }}"><i class="fas fa-envelope"></i></a>
            {% endif %}
            {% if person.link %}
              <a href="{{ person.link }}"><i class="fas fa-globe"></i></a>
            {% endif %}
          </div>

        </div>
      {% endfor %}
    </div>
    {% endif %}


